{
  "name": "hub-elev-muniz",
  "private": true,
  "version": "0.1.0",
  "description": "Hub Elev Muniz: gestão de documentos e operações de crédito de clientes (Supabase + GitHub Pages).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch-path=server server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.js",
    "typecheck": "tsc -p web/tsconfig.json",
    "funcao": "node scripts/funcao.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "express": "5.3.0",
    "multer": "2.5.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.103.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "zustand": "5.0.15"
  }
}
